# Copy this file to .env and fill in your values.

# Port used by the original Flask dev server (python app.py)
MT5_API_PORT=5000

# Waitress internal binding (wsgi.py / Windows service)
MT5_WSGI_HOST=127.0.0.1
MT5_WSGI_PORT=8000
MT5_WSGI_THREADS=4

# API key for all endpoints (leave empty to disable auth in dev)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-key-here

# Sync job queue (POST /sync_account_history)
# How long (seconds) a completed/failed job's result stays in memory
# before the worker garbage-collects it.
SYNC_JOB_TTL_SECONDS=3600

# mt5.initialize() login timeout (ms). MT5 default is 60000; a bad server name
# blocks the whole API for that long.
MT5_LOGIN_TIMEOUT_MS=20000
# After login, wait for the account's deal history to finish loading: sample
# the deal count every INTERVAL seconds until it holds steady, up to TIMEOUT.
MT5_HISTORY_SETTLE_INTERVAL_S=1.0
MT5_HISTORY_SETTLE_TIMEOUT_S=15.0
